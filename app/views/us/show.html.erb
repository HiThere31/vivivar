<%# 07 Nosotros %>
<div class="flex flex-col gap-3.5">
  <h1 class="title-lg mb-1">Nosotros</h1>

  <div class="card card-feature">
    <div class="overline" style="letter-spacing:.06em">Para vernos</div>
    <% if @progress %>
      <div class="mt-0.5 flex items-baseline gap-2.5">
        <span class="count-num"><%= (@meet_on - @today).to_i %></span>
        <span class="count-unit"><%= (@meet_on - @today).to_i == 1 ? "día" : "días" %></span>
        <span class="ml-auto" style="font:500 14px var(--f-sans);color:var(--muted)"><%= fecha_corta(@meet_on) %> ✈️</span>
      </div>
      <div class="progress"><div style="width: <%= @progress %>%"></div></div>
    <% else %>
      <div class="question-text" style="margin-top:4px">¿Cuándo se vuelven a ver?</div>
    <% end %>

    <details class="mt-3" <%= "open" unless @progress %>>
      <summary class="small-link"><%= @progress ? "Cambiar fecha" : "Poner fecha" %></summary>
      <%= form_with url: us_path, method: :patch, class: "mt-3 flex gap-2" do |f| %>
        <%= f.date_field :meet_on, value: @meet_on, min: @today, required: true, class: "field" %>
        <button type="submit" class="send-btn" style="width:52px;height:52px" aria-label="Guardar fecha">
          <%= icon(:arrow_right, size: 18, stroke: 2) %>
        </button>
      <% end %>
    </details>
  </div>

  <div class="card card-feature" style="padding:18px 22px">
    <div class="flex items-baseline justify-between">
      <span style="font:500 22px var(--f-display)">🔥 <%= @streak %> <%= @streak == 1 ? "día seguido" : "días seguidos" %></span>
      <span style="font:500 13px var(--f-sans);color:var(--muted)">récord <%= @best %></span>
    </div>
    <div class="week-dots">
      <% @week.each do |date| %>
        <% dot = if @revealed.include?(date) then "is-done"
                 elsif date == @today then "is-today"
                 else "is-off" end %>
        <div><span class="streak-dot <%= dot %>"></span><%= inicial_dia(date) %></div>
      <% end %>
    </div>
  </div>

  <% if Current.user.partner %>
    <%= button_to thinking_path, class: "btn btn-featured", data: { turbo_submits_with: "Enviando… 💭" } do %>
      Pensando en ti 💭
    <% end %>
  <% end %>

  <div class="list-card" style="padding:4px 20px">
    <%# Estado del dispositivo (permanente para que el morph no lo resetee) %>
    <div id="push-device" class="push-device" data-turbo-permanent
         data-controller="push" data-push-vapid-key-value="<%= vapid_public_key %>">
      <div class="flex-1">
        <div style="font:500 15px var(--f-sans)">Notificaciones</div>
        <div class="push-status" data-push-target="status">Revisando…</div>
      </div>
      <button type="button" class="chip push-enable" hidden
              data-push-target="button" data-action="push#enable">
        <%= icon(:bell, size: 16) %>Activar
      </button>
    </div>

    <%= form_with model: Current.user, url: notification_settings_path, method: :patch,
                  data: { controller: "auto-submit" } do |f| %>
      <label class="toggle-row">
        <span class="flex-1">Cuando sube su foto</span>
        <%= f.check_box :notify_uploads, class: "toggle", data: { action: "auto-submit#submit" } %>
      </label>
      <label class="toggle-row">
        <span class="flex-1">Cuando se revelan o te responde</span>
        <%= f.check_box :notify_reveals, class: "toggle", data: { action: "auto-submit#submit" } %>
      </label>
      <label class="toggle-row">
        <span class="flex flex-1 flex-col gap-0.5">
          <span>Recordatorio diario</span>
          <span style="font:400 13px var(--f-sans);color:var(--muted)">8:00 p. m. si falta tu foto</span>
        </span>
        <%= f.check_box :notify_reminder, class: "toggle", data: { action: "auto-submit#submit" } %>
      </label>
    <% end %>
  </div>

  <%= button_to "Enviar notificación de prueba", test_push_subscriptions_path,
                class: "small-link", form_class: "text-center", style: "background:none;border:0;padding:0" %>

  <div class="card card-feature" style="padding:18px 22px">
    <div class="overline" style="letter-spacing:.06em">Tu nombre</div>
    <%= form_with url: us_path, method: :patch, class: "mt-3 flex gap-2" do |f| %>
      <%= f.text_field :name, value: Current.user.name, maxlength: 30, required: true,
                              autocomplete: "given-name", class: "field", "aria-label": "Tu nombre" %>
      <button type="submit" class="send-btn" style="width:52px;height:52px" aria-label="Guardar nombre">
        <%= icon(:arrow_right, size: 18, stroke: 2) %>
      </button>
    <% end %>
    <% if Current.user.partner %>
      <p class="hint mt-2 text-left" style="font-size:13px">Así te ve <%= Current.user.partner.name %> en la app.</p>
    <% end %>
  </div>

  <%= button_to "Cerrar sesión", session_path, method: :delete, class: "btn btn-secondary mt-2" %>
</div>
