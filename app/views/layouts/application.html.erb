<!DOCTYPE html>
<html lang="es" data-theme="<%= Current.user&.theme.presence || "ella" %>">
  <head>
    <title><%= content_for(:title) || "Nuestro diario" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Nuestro diario">
    <meta name="theme-color" content="<%= Current.user&.theme == "el" ? "#F5F3EE" : "#FFF7F0" %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% show_tabs = authenticated? && !content_for?(:hide_tabs) %>
  <body class="<%= "no-tabs" unless show_tabs %>">
    <main class="app-main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/tab_bar" if show_tabs %>
  </body>
</html>
